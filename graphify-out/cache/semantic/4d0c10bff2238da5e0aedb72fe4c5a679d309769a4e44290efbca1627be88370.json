{"nodes": [{"id": "readme_document", "label": "README.md", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_jallure", "label": "jallure", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Groovy-based integration that generates Allure Report compatible results directly during Apache JMeter test execution. Not suitable for load testing \u2014 designed for functional/API test reporting."}, {"id": "readme_allure_report", "label": "Allure Report", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_apache_jmeter", "label": "Apache JMeter", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_groovy", "label": "Groovy", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_gradle", "label": "Gradle", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_docker", "label": "Docker", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_jsr223_assertion", "label": "JSR223 Assertion", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "jallure.groovy is attached as a JSR223 Assertion to JMeter samplers because it reads prev (PreviousResult) after the sampler executes."}, {"id": "readme_orphaned_label_leak", "label": "Orphaned Label Leak", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a multi-step test case does not receive a stop, allure.label.* variables remain in JMeter's vars and may leak into the next test case. The reporter cannot fix this automatically because jallure.groovy runs as a JSR223 Assertion after the HTTP sampler, while annotations are declared in a JSR223 Sampler before the HTTP sampler. By the time the reporter sees a new start, vars already contains a mix of old leaked labels and new intentional ones."}, {"id": "readme_clearlabels_pattern", "label": "clearLabels Pattern", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended workaround for the Orphaned Label Leak: add a one-time init sampler at the start of the ThreadGroup that stores a clearLabels closure, then call it inside any declaration sampler that must start with a clean label state."}], "edges": [{"source": "readme_document", "target": "docs_jallure_usage_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_document", "target": "docs_project_structure_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_document", "target": "docs_test_composition_guide_document", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_jallure", "target": "readme_allure_report", "relation": "conceptually_related_to", "confidence": "EXTRACT